# AngleOS settings. Copy this file to ".env" and fill it in. NEVER share or commit the real .env.
# Names only here: no real values.

# Database (Neon). Looks like postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# First-admin setup. Only works while there are NO users. After the first account exists it does nothing.
ADMIN_EMAIL=
SETUP_CODE=

# AI. Set these in Render (Environment) and, for local use, in your private .env. Never paste them in chat.
GEMINI_API_KEY=

# Later phases (not needed yet):
# OPENAI_API_KEY=
# XAI_API_KEY=
# GETHOOKD_API_TOKEN=
